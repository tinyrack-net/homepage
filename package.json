{
  "name": "tinyrack-homepage",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm i18n:compile && react-router dev",
    "build": "pnpm typecheck && pnpm build:app",
    "build:app": "pnpm i18n:compile && react-router build",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./app/i18n/paraglide --strategy baseLocale --emit-ts-declarations",
    "preview": "vite preview",
    "typegen": "react-router typegen",
    "content:pull": "node scripts/content-pull.ts",
    "content:fixtures": "node scripts/content-fixtures.ts",
    "typecheck": "pnpm i18n:compile && pnpm typecheck:app",
    "typecheck:app": "react-router typegen && tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test": "pnpm i18n:compile && vitest",
    "test:unit": "pnpm i18n:compile && pnpm test:unit:app",
    "test:unit:app": "vitest run --project unit",
    "test:component": "pnpm i18n:compile && pnpm test:component:app",
    "test:component:app": "vitest run --project browser --passWithNoTests",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm i18n:compile && vitest run --project unit --coverage",
    "test:design-system": "tinyrack-ui-check",
    "test:checks": "pnpm i18n:compile && concurrently --kill-others-on-fail --names typecheck,biome,design-system,unit,component \"pnpm typecheck:app\" \"pnpm biome\" \"pnpm test:design-system\" \"pnpm test:unit:app\" \"pnpm test:component:app\"",
    "test:ci": "pnpm test:checks && pnpm test:e2e",
    "biome": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@tinyrack/docs": "0.24.0",
    "@tinyrack/ui": "0.35.0",
    "isbot": "^5.2.2",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "gray-matter": "^4.0.3",
    "playwright": "^1.64.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1",
    "yaml": "^2.9.1"
  }
}
