{
  "name": "tinyrack-homepage",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "import:ghost": "node scripts/import-ghost-content.mjs",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --project browser --coverage",
    "test:ci": "pnpm test:unit && pnpm test:component && pnpm test:e2e",
    "biome": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "astro": "^7.0.6",
    "daisyui": "^5.6.16",
    "remixicon": "^4.9.1",
    "tailwindcss": "4.3.2",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.61.1",
    "sharp": "0.35.3",
    "vite": "8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "4.108.0"
  }
}
