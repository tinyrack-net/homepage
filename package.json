{
  "name": "tinyrack-homepage",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && react-router build",
    "preview": "vite preview",
    "typegen": "react-router typegen",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "import:ghost": "node scripts/import-ghost-content.mjs",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ci": "pnpm test:unit && pnpm test:e2e",
    "biome": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@react-router/node": "8.2.0",
    "@tinyrack/docs": "^0.7.0",
    "@tinyrack/ui": "^0.8.0",
    "isbot": "5.2.0",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/ibm-plex-sans-jp": "^5.2.6",
    "@fontsource/ibm-plex-sans-kr": "^5.2.6",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "gray-matter": "^4.0.3",
    "playwright": "^1.61.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.2",
    "turndown": "^7.2.4",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.0.0",
    "vite": "8.1.3",
    "vitest": "^4.1.10",
    "wrangler": "4.108.0"
  }
}
