{
  "name": "tinyrack-homepage",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "import:ghost": "node scripts/import-ghost-content.mjs",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --project browser --coverage",
    "test:ci": "pnpm test:unit && pnpm test:component && pnpm test:e2e",
    "biome": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.0",
    "astro": "^6.4.6",
    "daisyui": "^5.5.23",
    "remixicon": "^4.9.1",
    "tailwindcss": "4.3.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "playwright": "^1.60.0",
    "sharp": "^0.35.1",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.8",
    "wrangler": "4.100.0"
  }
}
